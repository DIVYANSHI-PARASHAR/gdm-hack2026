# Server Port (defaults to 5173)
PORT=5173

# Optional: Gemini API Key for adaptive boss strategy via Gemini Decisions API (gemini-decision-1)
# Camera rival additionally requires Gemini 4 Hydrogen and paid-tier Gemini 4 Neon access.
# Game falls back automatically to deterministic local AI when omitted.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Google Health API OAuth 2.0 Credentials for post-match "Synced total calories"
# Scope used: https://www.googleapis.com/auth/googlehealth.activity_and_fitness.readonly
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5173/api/health/oauth/callback

# Optional: Shopify & Agentic Commerce ("Shop the Look") Configuration
# Defaults to Shopify's official developer mock.shop catalog and connected Shop Pay profile.
SHOPIFY_STORE_DOMAIN=mock.shop
# Optional Storefront Access Token (not needed for mock.shop)
SHOPIFY_STOREFRONT_TOKEN=your_shopify_storefront_access_token_here
# Optional Admin Access Token (completes real DraftOrder on custom merchant stores)
SHOPIFY_ADMIN_TOKEN=your_shopify_admin_access_token_here
# Connected Shopify Buyer Details used for 1-click "Yes, Buy It Now" purchase
SHOPIFY_BUYER_NAME=Arena Challenger
SHOPIFY_BUYER_EMAIL=challenger@ironpulse.gg
SHOPIFY_BUYER_ADDRESS=150 Elgin St, Ottawa, ON K2P 1L4, CA
# Product ID linked to Kai the Brawler's outfit (defaults to verified Puffer Jacket)
SHOPIFY_PRODUCT_ID=gid://shopify/Product/7983594340374
# Shopping agent model (defaults to Gemini 4 Neon at runtime, with local agentic fallback)
GEMINI_SHOPPING_MODEL=gemini-4-neon
